{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:protocol-lab:interpretation-2",
  "$defs": {
    "ArrayField": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "array",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "maximum": 16777216,
              "minimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Linear"
            }
          ],
          "title": "Count"
        },
        "fields": {
          "items": {
            "discriminator": {
              "mapping": {
                "array": "#/$defs/ArrayField",
                "bytes": "#/$defs/BytesField",
                "delimited_bytes": "#/$defs/DelimitedBytesField",
                "int": "#/$defs/IntField",
                "switch": "#/$defs/SwitchField"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/IntField"
              },
              {
                "$ref": "#/$defs/BytesField"
              },
              {
                "$ref": "#/$defs/DelimitedBytesField"
              },
              {
                "$ref": "#/$defs/ArrayField"
              },
              {
                "$ref": "#/$defs/SwitchField"
              }
            ]
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "name",
        "count",
        "fields"
      ],
      "title": "ArrayField",
      "type": "object"
    },
    "ByteRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ByteRange",
      "type": "object"
    },
    "BytesField": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bytes",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "length": {
          "anyOf": [
            {
              "maximum": 16777216,
              "minimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Linear"
            },
            {
              "$ref": "#/$defs/Remaining"
            },
            {
              "const": "remaining",
              "type": "string"
            }
          ],
          "title": "Length"
        },
        "constant_hex": {
          "anyOf": [
            {
              "maxLength": 8192,
              "pattern": "^(?:[a-fA-F0-9]{2})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constant Hex"
        }
      },
      "required": [
        "kind",
        "name",
        "length"
      ],
      "title": "BytesField",
      "type": "object"
    },
    "ChecksumCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "checksum",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Field",
          "type": "string"
        },
        "algorithm": {
          "enum": [
            "xor8",
            "sum8",
            "sum16",
            "internet_checksum",
            "CRC-8/SMBUS",
            "CRC-16/ARC",
            "CRC-16/IBM-3740",
            "CRC-16/IBM-SDLC",
            "CRC-32/ISO-HDLC"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "byte_order": {
          "enum": [
            "big",
            "little"
          ],
          "title": "Byte Order",
          "type": "string"
        },
        "coverage": {
          "default": "message",
          "enum": [
            "message",
            "before_field",
            "ranges"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "covered_ranges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ByteRange"
          },
          "maxItems": 16,
          "title": "Covered Ranges",
          "type": "array"
        },
        "exclude_field": {
          "default": true,
          "title": "Exclude Field",
          "type": "boolean"
        },
        "coverage_start": {
          "default": 0,
          "maximum": 16777216,
          "minimum": 0,
          "title": "Coverage Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "field",
        "algorithm",
        "byte_order"
      ],
      "title": "ChecksumCheck",
      "type": "object"
    },
    "CopiedValueCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "copied_value",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Name",
          "type": "string"
        },
        "source_field": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Source Field",
          "type": "string"
        },
        "target_field": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Target Field",
          "type": "string"
        },
        "source_direction": {
          "enum": [
            "a_to_b",
            "b_to_a"
          ],
          "title": "Source Direction",
          "type": "string"
        },
        "order": {
          "const": "packet_time",
          "default": "packet_time",
          "title": "Order",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "source_field",
        "target_field",
        "source_direction"
      ],
      "title": "CopiedValueCheck",
      "type": "object"
    },
    "CounterCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "counter",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Name",
          "type": "string"
        },
        "field": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Field",
          "type": "string"
        },
        "scope": {
          "const": "directed_stream",
          "default": "directed_stream",
          "title": "Scope",
          "type": "string"
        },
        "step": {
          "default": "fixed",
          "enum": [
            "fixed",
            "message_length",
            "payload_length"
          ],
          "title": "Step",
          "type": "string"
        },
        "increment": {
          "default": 1,
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Increment",
          "type": "integer"
        },
        "payload_field": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Field"
        },
        "wrap": {
          "default": true,
          "title": "Wrap",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name",
        "field"
      ],
      "title": "CounterCheck",
      "type": "object"
    },
    "DelimitedBytesField": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "delimited_bytes",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "terminator_hex": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^(?:[a-fA-F0-9]{2})+$",
          "title": "Terminator Hex",
          "type": "string"
        },
        "include_terminator": {
          "default": false,
          "title": "Include Terminator",
          "type": "boolean"
        },
        "max_length": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "missing_terminator": {
          "const": "failed",
          "default": "failed",
          "title": "Missing Terminator",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "terminator_hex",
        "max_length"
      ],
      "title": "DelimitedBytesField",
      "type": "object"
    },
    "EventAssociationCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "event_association",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Name",
          "type": "string"
        },
        "before_ns": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Before Ns",
          "type": "integer"
        },
        "after_ns": {
          "default": 1000000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "After Ns",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "EventAssociationCheck",
      "type": "object"
    },
    "FixedRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        },
        "size": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "size"
      ],
      "title": "FixedRule",
      "type": "object"
    },
    "FramingSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "framing-1",
          "default": "framing-1",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "default": 0,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "rule": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedRule",
              "length": "#/$defs/LengthRule",
              "manual": "#/$defs/ManualRule",
              "markers": "#/$defs/MarkerRule"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ManualRule"
            },
            {
              "$ref": "#/$defs/FixedRule"
            },
            {
              "$ref": "#/$defs/LengthRule"
            },
            {
              "$ref": "#/$defs/MarkerRule"
            }
          ],
          "title": "Rule"
        },
        "max_message_bytes": {
          "default": 1048576,
          "maximum": 16777216,
          "minimum": 1,
          "title": "Max Message Bytes",
          "type": "integer"
        },
        "max_pieces": {
          "default": 200000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Max Pieces",
          "type": "integer"
        }
      },
      "required": [
        "rule"
      ],
      "title": "FramingSpec",
      "type": "object"
    },
    "IntField": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "int",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "width": {
          "enum": [
            1,
            2,
            4,
            8
          ],
          "title": "Width",
          "type": "integer"
        },
        "signed": {
          "title": "Signed",
          "type": "boolean"
        },
        "endian": {
          "enum": [
            "big",
            "little"
          ],
          "title": "Endian",
          "type": "string"
        },
        "constant": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constant"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "required": [
        "kind",
        "name",
        "width",
        "signed",
        "endian"
      ],
      "title": "IntField",
      "type": "object"
    },
    "LengthCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "length",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "maximum": 16777216,
              "minimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/Linear"
            }
          ],
          "title": "Expected"
        }
      },
      "required": [
        "kind",
        "field",
        "expected"
      ],
      "title": "LengthCheck",
      "type": "object"
    },
    "LengthRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "length",
          "title": "Kind",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 65536,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "width": {
          "default": 2,
          "enum": [
            1,
            2,
            4,
            8
          ],
          "title": "Width",
          "type": "integer"
        },
        "endian": {
          "default": "big",
          "enum": [
            "big",
            "little"
          ],
          "title": "Endian",
          "type": "string"
        },
        "multiplier": {
          "default": 1,
          "maximum": 65536,
          "minimum": 1,
          "title": "Multiplier",
          "type": "integer"
        },
        "adjustment": {
          "default": 0,
          "maximum": 16777216,
          "minimum": -16777216,
          "title": "Adjustment",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LengthRule",
      "type": "object"
    },
    "Linear": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Field",
          "type": "string"
        },
        "multiplier": {
          "default": 1,
          "maximum": 65536,
          "minimum": 1,
          "title": "Multiplier",
          "type": "integer"
        },
        "add": {
          "default": 0,
          "maximum": 16777216,
          "minimum": -16777216,
          "title": "Add",
          "type": "integer"
        }
      },
      "required": [
        "field"
      ],
      "title": "Linear",
      "type": "object"
    },
    "ManualRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "manual",
          "title": "Kind",
          "type": "string"
        },
        "ranges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ByteRange"
          },
          "maxItems": 10000,
          "title": "Ranges",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ManualRule",
      "type": "object"
    },
    "MarkerRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "markers",
          "title": "Kind",
          "type": "string"
        },
        "start_hex": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^(?:[a-fA-F0-9]{2})+$",
          "title": "Start Hex",
          "type": "string"
        },
        "end_hex": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^(?:[a-fA-F0-9]{2})+$",
          "title": "End Hex",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start_hex",
        "end_hex"
      ],
      "title": "MarkerRule",
      "type": "object"
    },
    "ParameterMappingCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "parameter_mapping",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Name",
          "type": "string"
        },
        "field": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Field",
          "type": "string"
        },
        "parameter_path": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Parameter Path",
          "type": "array"
        },
        "encoding": {
          "enum": [
            "ascii",
            "utf-8",
            "utf-16le",
            "utf-16be",
            "decimal",
            "integer"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "base64": {
          "default": "none",
          "enum": [
            "none",
            "standard",
            "urlsafe"
          ],
          "title": "Base64",
          "type": "string"
        },
        "padding": {
          "default": true,
          "title": "Padding",
          "type": "boolean"
        },
        "bom": {
          "default": false,
          "title": "Bom",
          "type": "boolean"
        },
        "width": {
          "default": 4,
          "enum": [
            1,
            2,
            4,
            8
          ],
          "title": "Width",
          "type": "integer"
        },
        "endian": {
          "default": "little",
          "enum": [
            "big",
            "little"
          ],
          "title": "Endian",
          "type": "string"
        },
        "signed": {
          "default": false,
          "title": "Signed",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name",
        "field",
        "parameter_path",
        "encoding"
      ],
      "title": "ParameterMappingCheck",
      "type": "object"
    },
    "Remaining": {
      "additionalProperties": false,
      "properties": {
        "remaining_minus": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Remaining Minus",
          "type": "integer"
        }
      },
      "required": [
        "remaining_minus"
      ],
      "title": "Remaining",
      "type": "object"
    },
    "SwitchField": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "switch",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "selector": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Selector",
          "type": "string"
        },
        "cases": {
          "additionalProperties": {
            "items": {
              "discriminator": {
                "mapping": {
                  "array": "#/$defs/ArrayField",
                  "bytes": "#/$defs/BytesField",
                  "delimited_bytes": "#/$defs/DelimitedBytesField",
                  "int": "#/$defs/IntField",
                  "switch": "#/$defs/SwitchField"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/IntField"
                },
                {
                  "$ref": "#/$defs/BytesField"
                },
                {
                  "$ref": "#/$defs/DelimitedBytesField"
                },
                {
                  "$ref": "#/$defs/ArrayField"
                },
                {
                  "$ref": "#/$defs/SwitchField"
                }
              ]
            },
            "type": "array"
          },
          "maxProperties": 32,
          "minProperties": 1,
          "title": "Cases",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "name",
        "selector",
        "cases"
      ],
      "title": "SwitchField",
      "type": "object"
    },
    "TimestampCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "timestamp",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9]{1,4}\\]|\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "title": "Name",
          "type": "string"
        },
        "field": {
          "maxLength": 512,
