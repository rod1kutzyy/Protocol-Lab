FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
WORKDIR /lab
COPY backend/pyproject.toml backend/uv.lock /lab/backend/
COPY backend/src /lab/backend/src
RUN pip install --no-cache-dir uv==0.13.0 && cd backend && uv sync --frozen --no-dev
COPY scripts /lab/scripts
ENV PATH="/lab/backend/.venv/bin:$PATH"
CMD ["python", "scripts/benchmark.py", "--output", "/results", "--profile", "control"]
