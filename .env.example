# Copy to .env; choose a password and use the same password in DATABASE_URL.
# Values are placeholders, not real credentials. .env is ignored by git.
PROTOCOL_LAB_POSTGRES_PASSWORD=CHANGE_ME
PROTOCOL_LAB_DATABASE_URL=postgresql+psycopg://protocol_lab:CHANGE_ME@127.0.0.1:5432/protocol_lab
PROTOCOL_LAB_PROJECT_ROOT=./projects
# Protective limits, not protocol format limits:
PROTOCOL_LAB_MAX_UPLOAD_BYTES=134217728
PROTOCOL_LAB_MAX_BLOCK_BYTES=16777216
PROTOCOL_LAB_MAX_PACKETS=1000000
# ZIP upload limit; expanded bundle is separately bounded at 2 GiB:
PROTOCOL_LAB_MAX_ARCHIVE_BYTES=536870912
# Local concurrent worker processes and retained job snapshots:
PROTOCOL_LAB_MAX_WORKERS=2
PROTOCOL_LAB_MAX_JOBS=128
# Validation JSONL row/UTF-8 byte budget (also applied by CLI apply):
PROTOCOL_LAB_MAX_VALIDATION_RESULTS=500000
PROTOCOL_LAB_MAX_VALIDATION_BYTES=536870912
PROTOCOL_LAB_MAX_INTERPRETATION_BYTES=268435456
